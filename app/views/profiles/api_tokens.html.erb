<div class="container-sm py-12">
  <div class="mb-8 text-center">
    <h1 class="text-2xl md:text-3xl font-bold text-primary">API Token</h1>
    <p class="text-secondary mt-2">生成 Token 给青狮龙虾，让它自动写正文 · 配封面 · 配插图 · 推送草稿箱</p>
  </div>

  <!-- 新生成的 token（仅显示一次） -->
  <% if @plain_token.present? %>
    <div class="card-elevated mb-6 border-2 border-warning" data-controller="clipboard">
      <div class="card-body">
        <h3 class="text-base font-bold text-primary mb-1 flex items-center gap-2">
          <%= lucide_icon "key-round", class: "w-5 h-5" %>
          新 Token 已生成
          <span class="text-xs font-normal text-warning">仅显示一次，请立即复制</span>
        </h3>
        <div class="flex items-center gap-2 mt-3">
          <code class="flex-1 bg-surface border border-border rounded px-3 py-2 font-mono text-sm break-all" data-clipboard-target="source"><%= @plain_token %></code>
          <button type="button" class="btn-primary whitespace-nowrap" data-action="click->clipboard#copy">
            <%= lucide_icon "copy", class: "w-4 h-4 mr-1" %>
            复制
          </button>
        </div>
        <p class="text-xs text-secondary mt-2">复制后粘贴到青狮龙虾配置文件 <code class="bg-surface px-1.5 py-0.5 rounded">~/.clacky/wemd-publisher.env</code> 即可。</p>
      </div>
    </div>
  <% end %>

  <!-- 生成新 token -->
  <div class="card-elevated mb-6">
    <div class="card-body">
      <h2 class="text-lg font-bold text-primary mb-3">生成新 Token</h2>
      <%= form_with url: create_api_token_profile_path, method: :post, local: true, class: "flex flex-col sm:flex-row gap-2" do |f| %>
        <%= f.text_field :name,
              placeholder: "Token 名称，如：青狮龙虾",
              required: true,
              maxlength: 50,
              class: "flex-1 input-field" %>
        <%= f.submit "生成 Token", class: "btn-primary whitespace-nowrap px-6" %>
      <% end %>
      <p class="text-xs text-secondary mt-3 flex items-start gap-1.5">
        <%= lucide_icon "info", class: "w-4 h-4 flex-shrink-0 mt-0.5" %>
        Token 明文只在创建瞬间显示一次，丢失只能删除重建。
      </p>
    </div>
  </div>

  <!-- 已有 token -->
  <div class="card-elevated">
    <div class="card-body">
      <h2 class="text-lg font-bold text-primary mb-4">
        已有 Token
        <span class="text-sm font-normal text-secondary">（<%= @api_tokens.size %>）</span>
      </h2>

      <% if @api_tokens.empty? %>
        <p class="text-sm text-secondary py-8 text-center">还没有 Token，用上方表单生成第一个。</p>
      <% else %>
        <div class="border border-border rounded-lg divide-y divide-border">
          <% @api_tokens.each do |t| %>
            <div class="p-4 flex items-center justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="font-medium text-primary truncate"><%= t.name %></div>
                <div class="text-xs text-secondary mt-1 font-mono">
                  <%= t.token_prefix %>••••••••
                </div>
                <div class="text-xs text-secondary mt-1">
                  创建于 <%= t.created_at.strftime("%Y-%m-%d %H:%M") %>
                  <% if t.last_used_at %>
                    · 最近使用 <%= time_ago_in_words(t.last_used_at) %>前
                    <% if t.last_used_ip %>(<%= t.last_used_ip %>)<% end %>
                  <% else %>
                    · <span class="text-muted-foreground">从未使用</span>
                  <% end %>
                </div>
              </div>
              <%= button_to "删除",
                    destroy_api_token_profile_path(id: t.id),
                    method: :delete,
                    data: { turbo_confirm: "确认删除「#{t.name}」？外部调用将立即失效。" },
                    class: "btn-ghost text-sm text-destructive hover:bg-destructive/10" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="text-center mt-6">
    <%= link_to "← 返回编辑器", new_document_path, class: "btn-ghost text-sm" %>
  </div>
</div>
