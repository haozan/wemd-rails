<div class="container-sm flex items-center justify-center min-h-screen">
  <div class="card w-full max-w-md">
    <div class="card-body">
      <h1 class="text-3xl font-bold text-center text-primary mb-2">验证邮箱</h1>

      <p class="text-center text-muted text-sm mb-8">
        验证码已发送到 <strong class="text-primary"><%= @pending_user.email %></strong><br>
        请在 <strong>15 分钟</strong>内输入验证码
      </p>

      <%= form_with url: confirm_sign_up_path, method: :post, class: "space-y-6" do |f| %>
        <div>
          <%= label_tag :code, "验证码" %>
          <%= text_field_tag :code, nil,
              required: true,
              autofocus: true,
              autocomplete: "one-time-code",
              inputmode: "numeric",
              maxlength: 6,
              placeholder: "请输入 6 位验证码",
              class: "text-center text-2xl tracking-widest font-mono" %>
        </div>

        <div class="pt-2">
          <%= submit_tag "验证并完成注册", class: "btn-primary w-full btn-lg" %>
        </div>
      <% end %>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-border"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-3 bg-surface text-muted">没有收到邮件？</span>
        </div>
      </div>

      <div class="space-y-3 text-center">
        <%= button_to "重新发送验证码", resend_sign_up_path, method: :post,
            class: "btn-ghost w-full",
            data: { disable_with: "发送中..." } %>

        <%= link_to "← 返回修改邮箱", sign_up_path,
            class: "text-muted hover:text-secondary underline text-sm transition-colors" %>
      </div>
    </div>
  </div>
</div>
