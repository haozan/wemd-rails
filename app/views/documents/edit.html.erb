<!-- WeMD 编辑器页面 -->
<div class="wemd-container with-sidebar" 
     data-controller="wemd-editor image-upload history-panel"
     data-wemd-editor-themes-value="<%= @themes.to_json(only: [:id, :name, :css]) %>"
     data-history-panel-current-document-id-value="<%= @document.friendly_id %>"
     data-action="trigger-image-upload@window->image-upload#selectFile 
                  image-upload:uploaded->wemd-editor#handleImageUploaded">
  <%= form_with model: @document, class: "h-full", data: { wemd_editor_target: "form", turbo: false } do |f| %>
    
    <!-- Header -->
    <header class="wemd-header">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
        <!-- Top Row: Icons + Title (Mobile & Desktop) -->
        <div class="flex items-center gap-4 flex-1">
          <!-- History Panel Toggle -->
          <button type="button" 
                  class="text-muted-foreground hover:text-foreground transition-colors flex-shrink-0"
                  data-action="click->history-panel#toggle"
                  title="文章目录">
            <%= lucide_icon "folder", class: "w-5 h-5" %>
          </button>
          
          <!-- New Document Button -->
          <%= link_to new_document_path, 
                      class: "text-muted-foreground hover:text-foreground transition-colors flex-shrink-0",
                      title: "新建文章",
                      data: { turbo: false } do %>
            <%= lucide_icon "plus", class: "w-5 h-5" %>
          <% end %>
          
          <div class="flex-1 min-w-0">
            <%# 标题只读，由 markdown 里的 # 自动同步，不允许手动修改 %>
            <div class="text-xl font-semibold truncate text-foreground select-none"
                 data-wemd-editor-target="titleDisplay"><%= @document.title.presence || '无标题文档' %></div>
            <%# 隐藏字段用于表单提交，值由 JS 从 markdown 提取后写入 %>
            <%= f.hidden_field :title, data: { wemd_editor_target: "titleInput" } %>
            <div class="text-sm text-muted-foreground mt-1">
              <span data-wemd-editor-target="currentTime"><%= Time.current.strftime("%Y年%m月%d日 %H:%M:%S") %></span>
            </div>
          </div>

          <!-- Save Status Indicator (Desktop only) -->
          <div class="hidden md:flex items-center gap-2">
            <span class="text-sm text-muted-foreground whitespace-nowrap" data-wemd-editor-target="saveStatus">已保存</span>
          </div>
        </div>

        <!-- Bottom Row: Action Buttons (Mobile: stacked, Desktop: inline) -->
        <div class="flex items-center gap-2 flex-wrap md:flex-nowrap">
          <!-- Save Status Indicator (Mobile only) -->
          <div class="flex md:hidden items-center gap-2 w-full justify-end">
            <span class="text-xs text-muted-foreground" data-wemd-editor-target="saveStatus">已保存</span>
          </div>

          <!-- 强制使用"默认主题"(李笑来原版),不再给用户切换入口(保留 hidden input 保证表单兼容) -->
          <%= f.hidden_field :theme_id, value: @theme&.id, data: { wemd_editor_target: "themeSelect" } %>

          <!-- 配色方案选择器 (主色 + 加粗色) -->
          <% current_primary = current_user.wx_primary_color.presence || Wechat::ThemeStyleMaps::DEFAULT_SCHEME[:primary] %>
          <% current_bold    = current_user.wx_bold_color.presence    || Wechat::ThemeStyleMaps::DEFAULT_SCHEME[:bold] %>
          <div class="relative" data-controller="color-picker"
               data-color-picker-url-value="<%= update_color_scheme_profile_path %>"
               data-color-picker-primary-value="<%= current_primary %>"
               data-color-picker-bold-value="<%= current_bold %>">
            <button type="button"
                    class="btn-outline p-2 md:p-2.5 flex items-center gap-1.5"
                    data-action="click->color-picker#toggle"
                    title="配色方案(主色 + 加粗色)">
              <!-- 双色小指示块:左主色,右加粗色 -->
              <span class="inline-flex w-5 h-5 rounded overflow-hidden border border-border/60">
                <span class="w-1/2 h-full" data-color-picker-target="primarySwatch"
                      style="background:<%= current_primary %>;"></span>
                <span class="w-1/2 h-full" data-color-picker-target="boldSwatch"
                      style="background:<%= current_bold %>;"></span>
              </span>
              <span class="hidden md:inline text-xs text-muted-foreground">配色</span>
              <%= lucide_icon "chevron-down", class: "w-3 h-3 text-muted-foreground" %>
            </button>

            <!-- Popover Panel -->
            <div class="hidden absolute right-0 top-full mt-2 z-50 w-80 p-4 rounded-lg border border-border bg-background shadow-lg"
                 data-color-picker-target="panel">
              <div class="flex items-center justify-between mb-1">
                <h4 class="text-sm font-semibold">配色方案</h4>
                <button type="button" class="text-xs text-muted-foreground hover:text-foreground"
                        data-action="click->color-picker#reset"
                        title="恢复默认">重置</button>
              </div>
              <p class="text-xs text-muted-foreground mb-3">
                <span class="font-medium text-foreground">主色</span>用于链接/引用/标题点缀;
                <span class="font-medium text-foreground">加粗色</span>用于 <strong>重点文字</strong>,两者形成对比。
              </p>

              <!-- 方案卡片网格 -->
              <div class="grid grid-cols-1 gap-2">
                <% Wechat::ThemeStyleMaps::COLOR_SCHEMES.each do |scheme| %>
                  <button type="button"
                          class="flex items-center gap-3 px-3 py-2 rounded border border-border hover:border-primary/50 hover:bg-muted/40 transition text-left"
                          data-action="click->color-picker#setScheme"
                          data-scheme-id="<%= scheme[:id] %>"
                          data-primary="<%= scheme[:primary] %>"
                          data-bold="<%= scheme[:bold] %>"
                          data-color-picker-target="schemeOption">
                    <!-- 双色圆片 -->
                    <span class="inline-flex w-10 h-6 rounded overflow-hidden border border-border/60 flex-shrink-0">
                      <span class="w-1/2 h-full" style="background:<%= scheme[:primary] %>;"></span>
                      <span class="w-1/2 h-full" style="background:<%= scheme[:bold] %>;"></span>
                    </span>
                    <span class="flex-1 min-w-0">
                      <span class="block text-sm font-medium truncate"><%= scheme[:name] %></span>
                      <span class="block text-xs text-muted-foreground font-mono">
                        <%= scheme[:primary] %> + <span style="color:<%= scheme[:bold] %>;font-weight:700"><%= scheme[:bold] %></span>
                      </span>
                    </span>
                    <!-- 选中标记 -->
                    <span class="hidden text-primary flex-shrink-0"
                          data-color-picker-target="checkMark"
                          data-scheme-id="<%= scheme[:id] %>">
                      <%= lucide_icon "check", class: "w-4 h-4" %>
                    </span>
                  </button>
                <% end %>
              </div>

              <p class="text-xs text-muted-foreground mt-3 hidden" data-color-picker-target="status"></p>
            </div>
          </div>

          <!-- Copy to WeChat Button (hidden for new documents) -->
          <div class="flex gap-2 items-center">
            <button type="button"
                    class="btn-primary text-base md:text-lg whitespace-nowrap <%= 'hidden' if @document.new_record? %>"
                    data-wemd-editor-target="syncButton"
                    data-action="click->wemd-editor#syncToWechat">
              <%= lucide_icon "cloud-upload", class: "w-5 h-5 md:w-6 md:h-6" %>
              <span>一键同步草稿箱</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Workspace -->
    <main class="wemd-main">
      <div class="wemd-workspace">
        <!-- Editor Pane -->
        <div class="wemd-editor-pane">
          <div class="wemd-toolbar">
            <!-- 撤销/重做按钮 -->
            <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#undo" title="撤销 (Ctrl+Z)">
              <%= lucide_icon "undo", class: "w-4 h-4" %>
            </button>
            <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#redo" title="重做 (Ctrl+Shift+Z)">
              <%= lucide_icon "redo", class: "w-4 h-4" %>
            </button>
            
            <div class="wemd-toolbar-divider"></div>
            
            <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#insertBold" title="加粗">
              <%= lucide_icon "bold", class: "w-4 h-4" %>
            </button>
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertItalic" title="斜体">
              <%= lucide_icon "italic", class: "w-4 h-4" %>
            </button>
            
            <!-- 标题下拉菜单 -->
            <div class="wemd-heading-dropdown wemd-dropdown-container">
              <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#toggleHeadingMenu" title="标题">
                <%= lucide_icon "heading", class: "w-4 h-4" %>
              </button>
              <div class="wemd-heading-menu wemd-dropdown-menu hidden">
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertHeadingLevel"
                        data-prefix="# "
                        data-placeholder="一级标题">
                  <%= lucide_icon "heading-1", class: "w-3.5 h-3.5 mr-2" %>
                  <span>一级标题</span>
                </button>
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertHeadingLevel"
                        data-prefix="## "
                        data-placeholder="二级标题">
                  <%= lucide_icon "heading-2", class: "w-3.5 h-3.5 mr-2" %>
                  <span>二级标题</span>
                </button>
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertHeadingLevel"
                        data-prefix="### "
                        data-placeholder="三级标题">
                  <%= lucide_icon "heading-3", class: "w-3.5 h-3.5 mr-2" %>
                  <span>三级标题</span>
                </button>
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertHeadingLevel"
                        data-prefix="#### "
                        data-placeholder="四级标题">
                  <%= lucide_icon "heading-4", class: "w-3.5 h-3.5 mr-2" %>
                  <span>四级标题</span>
                </button>
              </div>
            </div>
            
            <div class="wemd-toolbar-divider hidden md:block"></div>
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertLink" title="链接">
              <%= lucide_icon "link", class: "w-4 h-4" %>
            </button>
            <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#insertImage" title="图片">
              <%= lucide_icon "image", class: "w-4 h-4" %>
            </button>
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertCode" title="代码块">
              <%= lucide_icon "code", class: "w-4 h-4" %>
            </button>
            
            <div class="wemd-toolbar-divider"></div>
            
            <!-- 列表下拉菜单 -->
            <div class="wemd-list-dropdown wemd-dropdown-container">
              <button type="button" class="wemd-tool-btn" data-action="click->wemd-editor#toggleListMenu" title="列表">
                <%= lucide_icon "list", class: "w-4 h-4" %>
              </button>
              <div class="wemd-list-menu wemd-dropdown-menu hidden">
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertListType"
                        data-prefix="- "
                        data-placeholder="列表项">
                  <%= lucide_icon "list", class: "w-3.5 h-3.5 mr-2" %>
                  <span>无序列表</span>
                </button>
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertListType"
                        data-prefix="1. "
                        data-placeholder="列表项">
                  <%= lucide_icon "list-ordered", class: "w-3.5 h-3.5 mr-2" %>
                  <span>有序列表</span>
                </button>
                <button type="button" class="wemd-dropdown-item" 
                        data-action="click->wemd-editor#insertListType"
                        data-prefix="- [ ] "
                        data-placeholder="待办事项">
                  <%= lucide_icon "check-square", class: "w-3.5 h-3.5 mr-2" %>
                  <span>任务列表</span>
                </button>
              </div>
            </div>
            
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertQuote" title="引用">
              <%= lucide_icon "quote", class: "w-4 h-4" %>
            </button>
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertFootnote" title="脚注">
              <%= lucide_icon "superscript", class: "w-4 h-4" %>
              <span class="ml-1 text-xs" data-wemd-editor-target="footnoteNumber">[1]</span>
            </button>
            
            <div class="wemd-toolbar-divider hidden md:block"></div>
            
            <button type="button" class="wemd-tool-btn hidden md:inline-flex" data-action="click->wemd-editor#insertTable" title="表格">
              <%= lucide_icon "table", class: "w-4 h-4" %>
            </button>
          </div>

          <%= f.text_area :content,
              class: "wemd-editor-textarea",
              placeholder: "开始编写您的 Markdown 文档...",
              data: { 
                wemd_editor_target: "editor",
                action: "input->wemd-editor#updatePreview"
              } %>
        </div>

        <!-- Preview Pane -->
        <div class="wemd-preview-pane">
          <div class="wemd-preview-header flex items-center justify-between gap-3">
            <h3 class="text-sm font-semibold text-muted-foreground">
              <span data-wemd-editor-target="previewTitle">公众号真实效果</span>
              <span class="hidden text-xs font-normal text-muted-foreground ml-2" data-wemd-editor-target="previewBadge"></span>
            </h3>

            <!-- 复制到公众号后台（备用） -->
            <button type="button"
                    class="btn-outline border-primary text-primary hover:bg-primary/5 whitespace-nowrap p-2 <%= 'hidden' if @document.new_record? %>"
                    data-wemd-editor-target="copyButton"
                    data-action="click->wemd-editor#copyToWechat"
                    title="复制到公众号后台（备用）">
              <%= lucide_icon "copy", class: "w-4 h-4" %>
            </button>
          </div>

          <div class="wemd-preview-content"
               data-wemd-editor-target="preview previewContent"
               data-wechat-preview-url="<%= wechat_preview_document_path(@document) %>">
            <!-- Markdown 预览内容将通过 JS 渲染到这里 -->
          </div>
        </div>
      </div>
    </main>
  <% end %>

  <!-- History Panel Sidebar (常驻左侧，可折叠) -->
  <aside class="history-sidebar absolute top-0 left-0 bottom-0 bg-surface border-r border-border z-40 flex flex-col"
         data-history-panel-target="sidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-inner flex items-center justify-between border-b border-border bg-surface px-5 py-3">
      <h2 class="text-base font-semibold text-foreground flex items-center gap-2">
        <%= lucide_icon "folder", class: "w-4 h-4" %>
        文章目录
      </h2>
      <button type="button"
              class="text-muted-foreground hover:text-foreground transition-colors"
              data-action="click->history-panel#toggle"
              title="折叠">
        <%= lucide_icon "panel-left-close", class: "w-5 h-5" %>
      </button>
    </div>

    <!-- Search Bar -->
    <div class="sidebar-inner border-b border-border bg-surface px-5 py-3">
      <div class="relative">
        <%= lucide_icon "search", class: "absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-muted-foreground" %>
        <input type="text"
               placeholder="搜索文章..."
               class="w-full pl-10 pr-4 py-2 bg-muted border border-border rounded-lg 
                      text-sm focus:outline-none focus:ring-2 focus:ring-primary"
               data-history-panel-target="searchInput"
               data-action="input->history-panel#search" />
      </div>
    </div>

    <!-- History List -->
    <div class="sidebar-inner flex-1 overflow-y-auto px-2 py-2">
      <!-- Loading State -->
      <div class="text-center py-12" data-history-panel-target="loadingState">
        <p class="text-muted-foreground">正在加载...</p>
      </div>

      <!-- Empty State -->
      <div class="text-center py-12 hidden" data-history-panel-target="emptyState">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-muted mb-4">
          <%= lucide_icon "file-text", class: "w-8 h-8 text-muted-foreground" %>
        </div>
        <p class="text-muted-foreground">暂无文章</p>
      </div>

      <!-- List Container -->
      <div class="hidden" data-history-panel-target="list">
        <!-- 文章列表项将通过 JS 渲染到这里 -->
      </div>
    </div>
  </aside>

  <!-- 折叠态展开按钮（absolute 浮在左上） -->
  <button type="button"
          class="history-expand-btn absolute top-3 left-3 z-40 hidden items-center justify-center w-9 h-9 rounded-md bg-surface border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
          data-history-panel-target="expandBtn"
          data-action="click->history-panel#toggle"
          title="展开文章目录">
    <%= lucide_icon "panel-left-open", class: "w-5 h-5" %>
  </button>

  <!-- Hidden file input for image upload -->
  <input type="file" 
         accept="image/*" 
         class="hidden" 
         data-image-upload-target="fileInput"
         data-action="change->image-upload#handleFileSelect" />
</div>

<!-- 加载必要的 CSS -->
<style id="theme-styles">
  <%= raw @theme.css if @theme %>
</style>

<style>
/* History Sidebar Styles */
.history-sidebar {
  width: 280px;
  max-width: 90vw;
  transition: width 0.25s ease;
}

.history-sidebar.is-collapsed {
  width: 0;
  border-right-width: 0;
  overflow: hidden;
}

.history-sidebar .sidebar-inner {
  transition: opacity 0.15s ease;
}

.history-sidebar.is-collapsed .sidebar-inner {
  opacity: 0;
  pointer-events: none;
}

/* 主内容区域为侧栏让位 */
.wemd-container.with-sidebar > form {
  padding-left: 280px;
  transition: padding-left 0.25s ease;
}

.wemd-container.with-sidebar.sidebar-collapsed > form {
  padding-left: 0;
}

@media (max-width: 768px) {
  .wemd-container.with-sidebar > form {
    padding-left: 0;
  }
  .history-sidebar {
    box-shadow: 0 10px 30px hsl(0 0% 0% / 0.15);
  }
}

/* 列表整体留白 & 滚动条 */
.history-sidebar [data-history-panel-target="list"] {
  padding: 4px 8px 16px;
}

/* 时间分组标签 */
.history-group-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: hsl(var(--color-muted-foreground));
  padding: 14px 8px 6px;
  position: sticky;
  top: 0;
  background: hsl(var(--color-surface));
  z-index: 1;
}
.history-group-label:first-child {
  padding-top: 8px;
}

/* 单条 entry */
.history-entry {
  position: relative;
  transition: background-color 0.15s ease;
  padding: 8px 10px 8px 12px !important;
  border-radius: 6px;
}

.history-entry + .history-entry {
  margin-top: 1px;
}

.history-entry:hover {
  background-color: hsl(var(--color-muted) / 0.7);
}

/* 选中态：左竖条 + 极淡背景，去除红色压迫感 */
.history-entry.is-active {
  background-color: hsl(var(--color-muted) / 0.85);
}

.history-entry.is-active::before {
  content: "";
  position: absolute;
  left: -8px;
  top: 8px;
  bottom: 8px;
  width: 3px;
  background-color: hsl(var(--color-primary));
  border-radius: 0 2px 2px 0;
}

.history-entry.is-active h4 {
  color: hsl(var(--color-foreground));
  font-weight: 600;
}

/* entry 标题与元信息字号 */
.history-entry h4 {
  font-size: 13px;
  line-height: 1.4;
}
.history-entry .entry-meta {
  font-size: 11px;
  line-height: 1.3;
  margin-top: 2px;
  color: hsl(var(--color-muted-foreground));
  opacity: 0.85;
}

/* 操作按钮组：默认隐藏，hover 才出 */
.history-entry .entry-actions {
  opacity: 0;
  transform: translateX(4px);
  transition: opacity 0.15s ease, transform 0.15s ease;
  pointer-events: none;
}

.history-entry:hover .entry-actions,
.history-entry:focus-within .entry-actions {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.history-entry .entry-actions button {
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
</style>
